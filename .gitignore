# Public source export is allowlisted. Existing private installations stay local.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/docs/
!/scripts/
!/.github/
!/team-delivery-kit/
!/bootstrap/
/bootstrap/*
!/bootstrap/infra/
/bootstrap/infra/*
!/bootstrap/infra/*.py
!/bootstrap/infra/*.sh
!/bootstrap/infra/Dockerfile*
!/bootstrap/infra/patches/
!/bootstrap/infra/tests/
!/bootstrap/infra/e2e_fixture/
!/bootstrap/infra/product_adapter_fixture/
# Old deployment configurations, skills from third parties, state and product
# worktrees are intentionally not a supported installer or public source export.
**/.local*/
**/backups/
**/__pycache__/
*.py[cod]
**/node_modules/
**/.venv/
**/.DS_Store
**/.env
**/.env.*
!**/.env.example
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.log
**/operator.json
**/sessions/
**/snapshots/
**/artifacts/
/team-delivery-kit/sandbox-github/
/team-delivery-kit/sandbox-github2/
/team-delivery-kit/evaluation/SEARCH-1-INTAKE-2026-10-02.md
/team-delivery-kit/evaluation/*.md
/team-delivery-kit/evaluation/*.json
!/team-delivery-kit/evaluation/sources.lock.json
!/team-delivery-kit/evaluation/SURGICAL-DRIVER-V3-QUALIFICATION-2026-10-04.json
!/team-delivery-kit/evaluation/TEMPLATE-LINES-V6-SOURCE-CANARY-2026-10-07.json
!/team-delivery-kit/evaluation/STARTUP-POLICY-OBSERVATIONS-2026-10-07.json
/team-delivery-kit/launchd/
**/*.operator-local.md
