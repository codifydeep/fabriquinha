FROM delivery-kit-quality-runner-base:20261023.1
# Preserve delivery-kit-quality-green-job:20261022.3 as the last complete
# post-implementation-copy Docker qualification until its successor passes it.
WORKDIR /opt/quality
COPY quality_green_job.py quality_reversion_job.py quality_delivery_snapshot.py quality_red_observation.py portable_contract.py test_runner_policy.py r3_snapshot_probe.py calibration_frozen_harness_probe.py generic_harness_calibration.py ./
COPY quality_node_baseline.py quality_node_reporter.mjs quality_node_evidence.py ./
COPY broker/quality_lifecycle_v2.py broker/test_first_protocol.py ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/quality
RUN mkdir /snapshot && chown 10000:10000 /snapshot && chmod 0700 /snapshot && python -B -c "import quality_green_job"
LABEL delivery-kit.component="quality-green-job" delivery-kit.qualification="not-native-delivery"
LABEL delivery-kit.quality-operations="snapshot_after_implementation_v2,observe_green_v2,observe_reversion_v2"
USER 10000:10000
WORKDIR /tmp
ENTRYPOINT ["python", "/opt/quality/quality_green_job.py"]
