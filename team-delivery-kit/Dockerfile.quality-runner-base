# Both sources already exist locally in the reference installation. No package
# installation, npm modules, model downloads, or architecture-specific paths.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS node_runtime
COPY prepare_quality_node_runtime.cjs /prepare_quality_node_runtime.cjs
RUN node /prepare_quality_node_runtime.cjs

FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
COPY --from=node_runtime /quality-node-runtime/ /
RUN node --version && python -c "import sqlite3,ssl,subprocess;print('Python stdlib and Node runtime available')"
LABEL delivery-kit.component="quality-runner-base" delivery-kit.qualification="not-native-delivery"
ENV PYTHONDONTWRITEBYTECODE=1
