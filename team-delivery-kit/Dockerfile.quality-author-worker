# Reuse the already flattened local runtime: no inherited anonymous volumes and
# no second multi-gigabyte filesystem copy. This is a local-only base tag; the
# expected local config ID is f85484409c92b52e7db70b8200b576b7e88da10372920f092c0508f86396c172.
# It is not a distributable registry manifest digest. Pin/qualify output ID.
# Retain delivery-kit-quality-author-worker:20261022.7 as the last full
# author/Red/review ACP canary rollback until its successor passes that chain.
# Retain delivery-kit-quality-author-worker:20261023.4 as the last installed
# worker while the paging successor is qualified; a candidate build is not an
# installed version and must not displace this rollback during image cleanup.
FROM delivery-kit-generic-calibration:20261011.7
USER root
COPY quality_phase_tools.py portable_contract.py test_runner_policy.py broker/review_tool_policy.py /opt/hermes/
COPY quality_phase_tools.py portable_contract.py test_runner_policy.py model_policy.py broker/worker_model_config.py /
COPY quality_review_stop.py quality_review_paging.py quality_review_verdict.py artifact_read_evidence.py /opt/hermes/
COPY broker/quality_review_reads.py /opt/hermes/
COPY install_quality_review_stop.py /install_quality_review_stop.py
RUN python /install_quality_review_stop.py
COPY tests/quality_phase_registry_canary.py /quality_phase_registry_canary.py
COPY tests/quality_review_registry_canary.py /quality_review_registry_canary.py
COPY tests/quality_implementation_registry_canary.py /quality_implementation_registry_canary.py
RUN PYTHONPATH=/opt/hermes:/ PYTHONDONTWRITEBYTECODE=1 python -B -c "import quality_phase_tools,review_tool_policy,worker_model_config"
LABEL delivery-kit.component="quality-author-worker" delivery-kit.qualification="not-native-delivery"
LABEL delivery-kit.quality-phases="tests_only_v2,test_review_v2,implementation_v2"
ENV PYTHONDONTWRITEBYTECODE=1
USER 10000:10000
WORKDIR /tmp
ENTRYPOINT ["python"]
