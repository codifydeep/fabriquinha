COPY broker/server.py /broker.py
COPY broker/acp_startup.py broker/acp_transport.py broker/validation_job.py /
COPY broker/worker_creation_intent.py /
COPY broker/controller_maintenance.py broker/maintenance_job_clock.py /
COPY broker/handoff_runtime.py /
COPY broker/quality_lifecycle_v2.py broker/quality_lifecycle_enrollment.py broker/quality_red_capture.py /
COPY broker/quality_red_snapshot.py broker/quality_author_admission.py broker/quality_author_worker.py broker/quality_author_launch.py /
COPY broker/quality_progress.py /
COPY broker/quality_test_review.py /
COPY broker/native.py broker/native_scope_note.py broker/quality_review_recovery.py /
COPY broker/quality_test_revision.py /
COPY broker/quality_review_bootstrap_recovery.py /
COPY broker/quality_worker_runtime.py broker/quality_review_launch.py broker/quality_launch_router.py /
COPY broker/quality_review_reads.py broker/quality_review_attestation.py broker/read_stream_receipts.py /
COPY broker/quality_implementation_admission.py /
COPY broker/quality_implementation_launch.py /
COPY broker/quality_delivery_capture.py /
